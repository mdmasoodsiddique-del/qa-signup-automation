# Copy this file to .env and fill it in. NEVER commit .env.
BASE_URL=https://authorized-partner.vercel.app

# Browser: msedge or chrome use your installed browser (needed if your PC blocks
# Playwright's bundled Chromium). Leave empty to use bundled Chromium.
BROWSER_CHANNEL=msedge
HEADLESS=false
SLOW_MO=0
RECORD_VIDEO=true

# Mailbox you control, used only for this assignment. Receives the 6-digit code.
TEST_EMAIL_BASE=your.test.mailbox@gmail.com
# plus  -> your.test.mailbox+qa<timestamp>@gmail.com (new address each run)
# exact -> uses TEST_EMAIL_BASE as is (only works once per account)
TEST_EMAIL_MODE=plus

# Leave empty to generate a random password every run.
TEST_PASSWORD=

# Email code: prompt (type it when asked) | env (OTP_CODE below) | imap (read mailbox)
OTP_MODE=prompt
OTP_CODE=
OTP_TIMEOUT=120
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Only the end-to-end tests create data on the live site. Off by default.
RUN_E2E=0

# A phone number (digits only, no +977) already registered on the site, for the
# duplicate test. Leave empty to skip that test.
DUPLICATE_PHONE=
